# Environment Configuration
NODE_ENV=development

# Database (MongoDB) Credentials & Config
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=examplesecret
MONGO_INITDB_DATABASE=lumana_db
MONGO_PORT=27017
MONGO_URI=mongodb://root:examplesecret@mongodb:27017/lumana_db?authSource=admin
MONGO_DB_NAME=lumana_db

# Redis Config
REDIS_HOST=redis
REDIS_PORT=6379

# Service A (NestJS) Config
SERVICE_A_PORT=3000
SERVICE_A_GRPC_PORT=50051

# Service B (Golang) Config
SERVICE_B_PORT=8080
SERVICE_B_GRPC_PORT=50052

# Service B (NestJS) Config
SERVICE_B_NESTJS_PORT=3001

# Per-service MongoDB databases (microservices should not share a database)
SERVICE_A_MONGO_DB_NAME=lumana_service_a
SERVICE_B_MONGO_DB_NAME=lumana_service_b
